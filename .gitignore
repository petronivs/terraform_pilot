# Local .terraform directories
**/.terraform/*

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local CLI configuration files
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lock file (safe, ensures reproducible provider versions)
!.terraform.lock.hcl

# Claude Code local project files (machine-specific, not for sharing)
.claude/
